cat > .gitignore << 'EOF'
# Build directories
build/
cmake-build-debug/
cmake-build-release/
*.out
*.exe

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# OS files
.DS_Store
Thumbs.db

# Data files (optional, comment out if you want to track)
# data/*.json

# Executables
bin/
EOF
